{
    "name": "khalidmaquilang/sensors-plus",
    "version": "0.1.0",
    "description": "A NativePHP Mobile plugin to access the accelerometer, gyroscope, magnetometer and barometer sensors",
    "type": "nativephp-plugin",
    "license": "MIT",
    "authors": [
        {
            "name": "Eskie Sirius Maquilang",
            "email": "eskiesiriusmaquilang@gmail.com"
        }
    ],
    "require": {
        "php": "^8.2",
        "nativephp/mobile": "^4.0"
    },
    "autoload": {
        "psr-4": {
            "Khalidmaquilang\\SensorsPlus\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Khalidmaquilang\\SensorsPlus\\SensorsPlusServiceProvider"
            ]
        },
        "nativephp": {
            "manifest": "nativephp.json"
        }
    },
    "require-dev": {
        "pestphp/pest": "^3.0"
    },
    "scripts": {
        "test": "pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}